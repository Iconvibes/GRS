/.freebuff

# logs
*.log

# env files (templates stay committable)
.env*
!.env.example
!.env.sample
!.env.template

# secrets
*.pem

# os / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# vercel
.vercel
